msgstr ""
"RSA-4096-sleutelpaar lokaal in de browser genereren & privésleutel downloaden"

#: includes/Admin/AdminDashboard.php:893
msgid "Öffentlicher RSA-Schlüssel (BEGIN PUBLIC KEY)"
msgstr "Openbare RSA-sleutel (BEGIN PUBLIC KEY)"

#: includes/Admin/AdminDashboard.php:899
