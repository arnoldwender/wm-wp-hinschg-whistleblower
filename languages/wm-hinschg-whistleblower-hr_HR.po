#~ msgstr ""
#~ "Sigurno pohranite ovaj privatni ključ kao WM_HINSCHG_PRIVATE_KEY u wp-"
#~ "config.php."

#~ msgid ""
#~ "In der Datenbank liegt nur der öffentliche Schlüssel (Offline-"
