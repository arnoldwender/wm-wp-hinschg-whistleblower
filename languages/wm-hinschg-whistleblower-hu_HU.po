"állapot lekérdezésének vagy a bizalmas üzenetváltásnak személyazonossága "
"felfedése nélkül."

#: includes/API/RestController.php:315
msgid "Case ID and Access Token are required."
msgstr "Az ügyazonosító és a hozzáférési kulcs megadása kötelező."

#: includes/API/RestController.php:329 includes/API/RestController.php:413
msgid "Invalid Case ID or Access Token."
msgstr "Érvénytelen ügyazonosító vagy hozzáférési kulcs."

#: includes/API/RestController.php:399
msgid "Case ID, Access Token, and message are required."
msgstr "Az ügyazonosító, a hozzáférési kulcs és az üzenet megadása kötelező."

#: includes/API/RestController.php:438
