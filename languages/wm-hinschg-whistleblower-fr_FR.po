msgstr "Le journal est vide alors que %d entrées étaient enregistrées."

#. translators: %d: audit entry id
#: includes/Crypto/Vault.php:866
#, php-format
msgid ""
"Kettenbruch bei Eintrag #%d: ein Eintrag wurde gelöscht, eingeschleust oder "
"umsortiert."
msgstr ""
"Rupture de chaîne à l'entrée #%d : une entrée a été supprimée, insérée ou "
"réordonnée."

#. translators: %d: audit entry id
#: includes/Crypto/Vault.php:906
#, php-format
