#~ msgstr ""
#~ "Salvestage see privaatvõti turvaliselt kui WM_HINSCHG_PRIVATE_KEY failis "
#~ "wp-config.php."

#~ msgid ""
#~ "In der Datenbank liegt nur der öffentliche Schlüssel (Offline-"
