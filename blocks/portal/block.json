{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wm/hinschg-portal",
	"version": "1.3.0",
	"title": "HinSchG Meldestelle Portal",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Internal whistleblowing reporting and case-status form under the German HinSchG.",
	"keywords": [ "hinschg", "whistleblower", "meldestelle", "compliance" ],
	"textdomain": "wm-hinschg-whistleblower",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Interne Meldestelle"
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "wm-hinschg-blocks-editor",
	"style": "wm-hinschg-portal-css"
}
