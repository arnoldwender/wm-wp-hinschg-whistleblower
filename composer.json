{
    "name": "arnoldwender/wm-hinschg-whistleblower",
    "description": "HinSchG whistleblower channel with encrypted vault and SLA tracking.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WMCyber\\HinSchG\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WMCyber\\HinSchG\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
